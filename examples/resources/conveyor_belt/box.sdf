<?xml version="1.0"?>
<sdf xmlns:drake="http://drake.mit.edu" version="1.7">
  <model name="box">
    <link name="box">
      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.0077083</ixx>
          <iyy>0.0077083</iyy>
          <izz>0.015</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <pose>0 0 0 0 0 0</pose>
      <visual name="box_visual">
        <geometry>
          <box>
            <size>0.3 0.3 0.15</size>
          </box>
        </geometry>
        <material>
          <ambient>1.0 1.0 0.0 0.6</ambient> <!-- Red -->
          <diffuse>1.0 1.0 0.0 0.6</diffuse>
        </material>
      </visual>
      <collision name="box_collision">
        <geometry>
          <box>
            <size>0.3 0.3 0.15</size>
          </box>
        </geometry>
        <drake:proximity_properties>
          <drake:compliant_hydroelastic/>
          <drake:hydroelastic_modulus>1e5</drake:hydroelastic_modulus>
          <drake:mesh_resolution_hint>0.01</drake:mesh_resolution_hint>
          <drake:mu_dynamic>1.4</drake:mu_dynamic>
          <drake:mu_static>1.5</drake:mu_static>
          <drake:hunt_crossley_dissipation>5</drake:hunt_crossley_dissipation>
        </drake:proximity_properties>
      </collision>
    </link>

    <!-- Links for the floating base chain. -->
    <link name="box_base_link"/>
    <link name="box_slider_x"/>
    <link name="box_slider_y"/>
    <link name="box_slider_z"/>

    <joint name="box_base_fixed" type="fixed">
      <parent>world</parent>
      <child>box_base_link</child>
    </joint>

    <!-- Translation along X -->
    <joint name="box_prismatic_x" type="prismatic">
      <parent>box_base_link</parent>
      <child>box_slider_x</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <effort>0</effort>
          <lower>-5</lower>
          <upper>5</upper>
        </limit>
      </axis>
    </joint>

    <!-- Translation along Y -->
    <joint name="box_prismatic_y" type="prismatic">
      <parent>box_slider_x</parent>
      <child>box_slider_y</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <effort>0</effort>
          <lower>-5</lower>
          <upper>5</upper>
        </limit>
      </axis>
    </joint>

    <!-- Translation along Z -->
    <joint name="box_prismatic_z" type="prismatic">
      <parent>box_slider_y</parent>
      <child>box_slider_z</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <effort>0</effort>
          <lower>-5</lower>
          <upper>5</upper>
        </limit>
      </axis>
    </joint>

    <!-- Yaw-only rotation -->
    <joint name="box_revolute_yaw" type="revolute">
      <parent>box_slider_z</parent>
      <child>box</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <effort>0</effort>
          <lower>-10</lower>
          <upper>10</upper>
        </limit>
      </axis>
    </joint>
  </model>
</sdf>
