<sdf version="1.7">
  <model name="conveyor_belt_tool_model">

    <link name="floor">
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>1</ixx>
          <iyy>1</iyy>
          <izz>1</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <pose>0 0 -0.5 0 0 0  </pose>
      <visual name="floor_visual">
        <geometry>
          <box>
            <size>10 10 1</size>
          </box>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1.0</ambient> <!-- Gray color -->
          <diffuse>0.5 0.5 0.5 1.0</diffuse>
        </material>
      </visual>
      <collision name="floor_collision">
        <geometry>
          <box>
            <size>10 10 1</size>
          </box>
        </geometry>
        <!-- <drake:proximity_properties>
          <drake:hydroelastic_modulus>1e8</drake:hydroelastic_modulus>
          <drake:mesh_resolution_hint>0.01</drake:mesh_resolution_hint>
          <drake:mu_dynamic>0.5</drake:mu_dynamic>
          <drake:mu_static>0.6</drake:mu_static>
          <drake:hunt_crossley_dissipation>5</drake:hunt_crossley_dissipation>
        </drake:proximity_properties> -->
      </collision>
    </link>
    <joint name="fixed_floor" type="fixed">
      <parent>world</parent>
      <child>floor</child>
    </joint>

    <link name="base_link">
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.000001</ixx>
          <iyy>0.000001</iyy>
          <izz>0.000001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
    </link>
    <link name="slider_x">
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.000001</ixx>
          <iyy>0.000001</iyy>
          <izz>0.000001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
    </link>
    <link name="hinge_x">
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.000001</ixx>
          <iyy>0.000001</iyy>
          <izz>0.000001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
    </link>
    <link name="slider_y">
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.000001</ixx>
          <iyy>0.000001</iyy>
          <izz>0.000001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
    </link>
    <link name="hinge_y">
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.000001</ixx>
          <iyy>0.000001</iyy>
          <izz>0.000001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
    </link>
    <link name="slider_z">
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.000001</ixx>
          <iyy>0.000001</iyy>
          <izz>0.000001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
    </link>
    <link name="conveyor_belt_tool">
      <inertial>
        <mass>1</mass>
        <inertia>
          <ixx>0.0077083</ixx>
          <iyy>0.0077083</iyy>
          <izz>0.015</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <pose> 0.5 1 0.17 0 1.57 0 </pose>
      <visual name="conveyor_belt_tool_visual">
        <geometry>
          <box> 
            <size> 0.3 0.3 0.05 </size>
          </box>
        </geometry>
        <material>
          <ambient> 1 0 0 1 </ambient>
          <diffuse> 1 0 0 1 </diffuse>
        </material>
      </visual>
      <collision name="conveyor_belt_tool_collision">
        <geometry>
          <box>
            <size> 0.3 0.3 0.05 </size>
          </box>
        </geometry>
        <drake:proximity_properties>
          <drake:hydroelastic_modulus> 1e8 </drake:hydroelastic_modulus>
          <drake:mu_dynamic> 0.8 </drake:mu_dynamic>
          <drake:mu_static> 1.0 </drake:mu_static>
          <drake:hunt_crossley_dissipation>1</drake:hunt_crossley_dissipation>
          <drake:point_contact_stiffness>1e9</drake:point_contact_stiffness>
          <drake:surface_speed>0.5</drake:surface_speed>
          <drake:surface_velocity_normal>0 1 0</drake:surface_velocity_normal>
        </drake:proximity_properties>
      </collision>
    </link>

    <joint name="base_fixed" type="fixed">
      <parent>world</parent>
      <child>base_link</child>
    </joint>

    <joint name="prismatic_z" type="prismatic">
      <parent>base_link</parent>
      <child>slider_z</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <effort>20</effort>
          <lower>-5</lower>
          <upper>5</upper>
        </limit>
      </axis>
    </joint>


    <joint name="prismatic_x" type="prismatic">
      <parent>slider_z</parent>
      <child>slider_x</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <effort>20</effort>
          <lower>-5</lower>
          <upper>5</upper>
        </limit>
      </axis>
    </joint>

    <joint name="revolute_x" type="revolute">
      <parent>slider_x</parent>
      <child>hinge_x</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <effort>20</effort>
          <lower>-5</lower>
          <upper>5</upper>
        </limit>
      </axis>
    </joint>

    <joint name="prismatic_y" type="prismatic">
      <parent>hinge_x</parent>
      <child>slider_y</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <effort>20</effort>
          <lower>-5</lower>
          <upper>5</upper>
        </limit>
      </axis>
    </joint>

    <joint name="revolute_y" type="revolute">
      <parent>slider_y</parent>
      <child>hinge_y</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <effort>20</effort>
          <lower>-5</lower>
          <upper>5</upper>
        </limit>
      </axis>
    </joint>

    <joint name="fixated" type="fixed">
      <parent>hinge_y</parent>
      <child>conveyor_belt_tool</child>
    </joint>

  </model>
</sdf>
