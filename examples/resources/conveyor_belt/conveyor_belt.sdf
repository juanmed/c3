<?xml version="1.0"?>
<sdf xmlns:drake="http://drake.mit.edu" version="1.7">
  <!-- This file shows how to create a conveyor belt with a box on top.
       It also shows how to define a surface velocity for other geometries. -->
  <model name="conveyor_belt_model">
    <!-- Floor -->
    <link name="ground">
      <pose>0, 0, 0, 0, 0, 0,</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>1.0</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1.0</iyy>
          <iyz>0</iyz>
          <izz>1.0</izz>
        </inertia>
      </inertial>
      <visual name="ground_visual">
        <geometry>
          <box>
            <size>40.0 40.0 0.05</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1.0</ambient> <!-- Red color -->
          <diffuse>0.05 0.05 0.05 1.0</diffuse>
        </material>
      </visual>
      <collision name="ground-collision">
        <geometry>
          <box>
            <size>40.0 40.0 0.05</size>
          </box>
        </geometry>
        <drake:proximity_properties>
          <drake:compliant_hydroelastic/>
          <drake:hydroelastic_modulus> 1e9 </drake:hydroelastic_modulus>
          <drake:mesh_resolution_hint> 0.01 </drake:mesh_resolution_hint>
          <drake:mu_dynamic>0.8</drake:mu_dynamic>
          <drake:mu_static>1.0</drake:mu_static>
          <drake:hunt_crossley_dissipation>5</drake:hunt_crossley_dissipation>
          <drake:point_contact_stiffness>1e4</drake:point_contact_stiffness>
        </drake:proximity_properties>
      </collision>
    </link>
    <joint name="fixed_ground" type="fixed">
      <parent>world</parent>
      <child>ground</child>
    </joint>

    <!-- Conveyor belt -->
    <link name="conveyor_belt">
      <pose> 0, 0, 1, 0, 0, 0</pose>
      <visual name="conveyor_belt_visual">
        <geometry>
          <box>
            <size>10.0 1.0 0.1</size>
          </box>
        </geometry>
        <material>
          <ambient>1.0 0.0 0.0 1.0</ambient> <!-- Red color -->
          <diffuse>1.0 0.0 0.0 1.0</diffuse>
        </material>
      </visual>
      <collision name="conveyor_belt_collision">
        <geometry>
          <box>
            <size>10.0 1.0 0.1</size>
          </box>
        </geometry>
        <drake:proximity_properties>
          <drake:compliant_hydroelastic/>
          <drake:hydroelastic_modulus> 1e8 </drake:hydroelastic_modulus>
          <drake:mesh_resolution_hint> 0.01 </drake:mesh_resolution_hint>
          <drake:mu_dynamic>0.8</drake:mu_dynamic>
          <drake:mu_static>1.0</drake:mu_static>
          <drake:hunt_crossley_dissipation>5</drake:hunt_crossley_dissipation>
          <drake:point_contact_stiffness>1e4</drake:point_contact_stiffness>
          <drake:surface_speed>0.5</drake:surface_speed>
          <drake:surface_velocity_normal>0 1 0</drake:surface_velocity_normal>
        </drake:proximity_properties>
      </collision>
    </link>
    <joint name="fixed_conveyor_belt" type="fixed">
      <parent>world</parent>
      <child>conveyor_belt</child>
    </joint>

    <!-- Blue cube on top of the conveyor belt -->
    <!-- <link name="box">
      <pose> -2, -2, 1.27, 0, 0.0, 0.0</pose>
      <visual name="box_visual">
        <geometry>
          <box>
            <size>0.4 0.4 0.4</size>
          </box>
        </geometry>
        <material>
          <ambient>0.0 0.0 1.0 1.0</ambient>
          <diffuse>0.0 0.0 1.0 1.0</diffuse>
        </material>
      </visual>
      <collision name="box_collision">
        <geometry>
          <box>
            <size>0.4 0.4 0.4</size>
          </box>
        </geometry>
        <drake:proximity_properties>
          <drake:compliant_hydroelastic/>
          <drake:hydroelastic_modulus> 1e6 </drake:hydroelastic_modulus>
          <drake:mesh_resolution_hint> 0.01 </drake:mesh_resolution_hint>
          <drake:mu_dynamic>0.7</drake:mu_dynamic>
          <drake:mu_static>0.7</drake:mu_static>
          <drake:hunt_crossley_dissipation>5</drake:hunt_crossley_dissipation>
          <drake:point_contact_stiffness>1e4</drake:point_contact_stiffness>        
        </drake:proximity_properties>
      </collision>
    </link> -->

    <link name="sphere">
      <pose> 0 0 1.27 0 0 0</pose>
      <visual name="sphere_visual_base">
        <geometry>
          <sphere>
            <radius>0.2</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.85 0.85 0.85 1.0</ambient>
          <diffuse>0.95 0.95 0.95 1.0</diffuse>
        </material>
      </visual>
      <visual name="sphere_marker_a">
        <pose>0.17 0.00 0.05 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.03</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.9 0.3 0.2 1.0</ambient>
          <diffuse>0.9 0.3 0.2 1.0</diffuse>
        </material>
      </visual>
      <visual name="sphere_marker_b">
        <pose>-0.05 0.15 -0.02 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.03</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.2 0.6 0.95 1.0</ambient>
          <diffuse>0.2 0.6 0.95 1.0</diffuse>
        </material>
      </visual>
      <visual name="sphere_marker_c">
        <pose>0.00 -0.18 0.03 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.03</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.95 0.85 0.2 1.0</ambient>
          <diffuse>0.95 0.85 0.2 1.0</diffuse>
        </material>
      </visual>
      <visual name="sphere_marker_d">
        <pose>-0.12 -0.04 0.15 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.03</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.3 0.95 0.35 1.0</ambient>
          <diffuse>0.3 0.95 0.35 1.0</diffuse>
        </material>
      </visual>
      <collision name="sphere_collision">
        <geometry>
          <sphere>
            <radius>0.2</radius>
          </sphere>
        </geometry>
        <drake:proximity_properties>
          <drake:compliant_hydroelastic/>
          <drake:hydroelastic_modulus> 1e6 </drake:hydroelastic_modulus>
          <drake:mesh_resolution_hint> 0.01 </drake:mesh_resolution_hint>
          <drake:mu_dynamic>0.7</drake:mu_dynamic>
          <drake:mu_static>0.7</drake:mu_static>
          <drake:hunt_crossley_dissipation>5</drake:hunt_crossley_dissipation>
          <drake:point_contact_stiffness>1e4</drake:point_contact_stiffness> 
        </drake:proximity_properties>
      </collision>
    </link>

    <link name="sphere_slider_x"/>
    <link name="sphere_slider_z"/>

    <joint name="sphere_prismatic_x" type="prismatic">
      <parent>world</parent>
      <child>sphere_slider_x</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <!-- This joint is not actuated. -->
          <effort>0</effort>
          <lower>-1.2</lower>
          <upper>1.2</upper>
        </limit>
      </axis>
    </joint>

    <joint name="sphere_prismatic_z" type="prismatic">
      <parent>sphere_slider_x</parent>
      <child>sphere_slider_z</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <!-- This joint is not actuated. -->
          <effort>0</effort>
          <lower>-1.2</lower>
          <upper>1.2</upper>
        </limit>
      </axis>
    </joint>

    <joint name="sphere_revolute_y" type="revolute">
      <parent>sphere_slider_z</parent>
      <child>sphere</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <!-- This joint is not actuated. -->
          <effort>0</effort>
          <lower>-1.2</lower>
          <upper>1.2</upper>
        </limit>
      </axis>
    </joint>

  </model>
</sdf>
